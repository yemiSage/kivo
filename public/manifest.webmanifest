{
  "id": "/",
  "name": "Kivo — Save anything",
  "short_name": "Kivo",
  "description": "Save posts, links, images and articles from anywhere. Find them when you need them.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "orientation": "portrait",
  "background_color": "#fafaf8",
  "theme_color": "#fafaf8",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png?v=k-mark-1",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png?v=k-mark-1",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-192.png?v=k-mark-1",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png?v=k-mark-1",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".gif",
            ".heic"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Save a link",
      "short_name": "Save",
      "url": "/save",
      "icons": [
        {
          "src": "/icons/icon-192.png?v=k-mark-1",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Search",
      "url": "/?search=1",
      "icons": [
        {
          "src": "/icons/icon-192.png?v=k-mark-1",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
