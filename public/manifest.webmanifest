{
  "id": "/",
  "name": "Kivo — Save anything",
  "short_name": "Kivo",
  "description": "Save posts, links, images and articles from anywhere. Find them when you need them.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#e7e7e4",
  "theme_color": "#0a0a0a",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "media", "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp", ".gif", ".heic"] }
      ]
    }
  },
  "shortcuts": [
    { "name": "Save a link", "short_name": "Save", "url": "/save", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Search", "url": "/search", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
