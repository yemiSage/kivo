# Copy to .env.local and use your own Supabase project. Never commit real credentials.
# Supabase project settings → API. The anon/publishable key is public; RLS is mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical public origin (used for metadata, sitemaps and auth email redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public operator details shown on Kivo's privacy and terms pages.
# Defaults identify the operator supplied for this product; forks should replace them.
KIVO_OPERATOR_NAME=MaestroTG
KIVO_PRIVACY_EMAIL=adegboyeopeyemiazeez@gmail.com
KIVO_OPERATOR_COUNTRY=Nigeria
KIVO_OPERATOR_CITY=Lagos

# Superadmin dashboard (server-only). Comma-separate multiple admin emails.
# Copy the service_role key from Supabase project settings; never prefix it with NEXT_PUBLIC_.
SUPERADMIN_EMAILS=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard display only: use your actual plan allowance in GB. Does not enforce quotas.
SUPABASE_STORAGE_QUOTA_GB=1
# Optional hostname only (no https:// or path); e.g. admin.example.com.
# Blank uses the upstream adminkivo-save.vercel.app redirect; /admin also works directly.
ADMIN_HOST=

# Brevo transactional email (server-only). The sender must be verified in Brevo.
BREVO_API_KEY=
KIVO_FROM_EMAIL=

# Optional: enables AI categorisation. Leave blank to use the built-in rules only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Private R2 Standard storage. All values are server-only.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kivo-media
