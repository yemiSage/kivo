# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the deployed app (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Superadmin dashboard (server-only). Comma-separate multiple admin emails.
# Copy the service_role key from Supabase project settings; never prefix it with NEXT_PUBLIC_.
SUPERADMIN_EMAILS=
SUPABASE_SERVICE_ROLE_KEY=
# Set to 100 after upgrading to Supabase Pro. Defaults to 1 when omitted.
SUPABASE_STORAGE_QUOTA_GB=1
# Admin hostname. The app defaults to this Vercel production domain.
ADMIN_HOST=adminkivo-save.vercel.app

# Brevo transactional email (server-only). The sender must be verified in Brevo.
BREVO_API_KEY=
KIVO_FROM_EMAIL=

# Optional: enables AI categorisation. Leave blank to use the built-in rules only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
